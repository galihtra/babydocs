#!/usr/bin/env sh
# Launcher babydocs (macOS / Linux).
# Mencari Python 3.8+; jika belum ada, memasangnya secara otomatis.
set -e

SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *)  SELF="$DIR/$TARGET" ;;
  esac
done
HOME_DIR="$(cd -P "$(dirname "$SELF")/.." && pwd)"

find_python() {
  for cand in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 python; do
    if command -v "$cand" >/dev/null 2>&1; then
      if "$cand" -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" >/dev/null 2>&1; then
        command -v "$cand"
        return 0
      fi
    fi
  done
  for uv_bin in "$(command -v uv 2>/dev/null || true)" "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
    if [ -n "$uv_bin" ] && [ -x "$uv_bin" ]; then
      found="$("$uv_bin" python find '>=3.8' 2>/dev/null || true)"
      if [ -n "$found" ] && [ -x "$found" ]; then
        printf '%s\n' "$found"
        return 0
      fi
    fi
  done
  return 1
}

PY="$(find_python || true)"
if [ -z "$PY" ]; then
  echo "⏳ Kebutuhan sistem (Python) belum terpasang. Memasang otomatis…" >&2
  sh "$HOME_DIR/install.sh" --python-only >&2
  PY="$(find_python || true)"
fi

if [ -z "$PY" ]; then
  echo "✗ Pemasangan otomatis gagal. Silakan jalankan: $HOME_DIR/install.sh" >&2
  exit 1
fi

exec "$PY" "$HOME_DIR/scripts/cli.py" "$@"
